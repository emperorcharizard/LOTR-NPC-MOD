+        void SweepHits(long now)
+        {
+            nextHitSweep = now + 10000;
+            hitSweepKeys.Clear();
+            foreach (KeyValuePair<long, long> kv in nextHitAt) if (kv.Value < now) hitSweepKeys.Add(kv.Key);
